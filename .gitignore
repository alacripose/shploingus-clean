/target
**/*.rs.bk
Cargo.lock.orig
*.pdb

# Build scratch and packaged output: a log of a build is not the source of one.
/.scratch/
/dist/

# Generated test workspaces: a run of the console writes hundreds of megabytes of chain here,
# which is the input to the next run rather than evidence of one.
logs/test-workspaces/

# The coding tool's own project marker and ledgers; project-id is machine-local.
/.freebuff/
