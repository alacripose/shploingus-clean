# The pinned HUD subset (H-9.8): stays in the user's view while the shell is hidden.
#
# The four geometries below are the four corners of a 1280 × 720 window with the
# 48 dp bar across the top, sized so the panel each window hosts fits inside it:
# **the port's chrome — a 1 dp border, a 40 dp title bar and a 40 dp pane header —
# plus the panel's own height** (the tallest is 407 dp at seven rows — the World
# panel, which grew two rows when the player's body started reporting whether it
# was on the ground and whether it was in water). The chrome is the port's
# (SHELL-PORT.md §5; the reference always draws a pane header, 2670–2675) and it
# is 34 dp taller than the derived shell's title bar alone, so **the four corners
# no longer clear the middle of the screen**: the left column (489 + 342) is
# taller than the 672 dp a 720 dp viewport leaves under the bar, and the bottom
# pair is anchored to the viewport's foot as before (720 − height). Owed a
# ruling; the declaration is kept rather than an arrangement invented here. At
# any other window size the windows keep these declarations — a shell that
# resized them would be choosing an arrangement, and the arrangement is a package
# (UI-SPEC §3).
window	world
	title	World
	content	world-view
	lane	world
	extent	square-pixels
	geometry	16 48 336 489
	min-size	240 192
	opacity	930
	elevation	0
	theme-role	hud
	pinnable	true
	layout	minimize,close,title-position
	behavior	drag
	record-id	window-world
window	determinism
	title	Determinism
	content	readout
	lane	frame
	extent	square-pixels
	geometry	16 378 336 342
	min-size	240 192
	opacity	930
	elevation	0
	theme-role	hud
	pinnable	true
	layout	minimize,close,title-position
	behavior	drag,resize,maximize,minimize,close
	record-id	window-determinism
window	refusals
	title	Refusals
	content	table
	lane	beacon
	extent	square-pixels
	geometry	928 378 336 342
	min-size	240 192
	opacity	930
	elevation	1
	theme-role	hud
	pinnable	true
	layout	minimize,close,title-position
	behavior	drag,resize,maximize,minimize,close
	record-id	window-refusals
# The six tabs of the bar, in strip order (H-15.2).
tab	inventory
tab	trees
tab	mods
tab	docs
tab	settings
tab	map-plan
# The one bar entry that is not a tab.
bar	console
# What each tab's menu offers (H-15.3). The tab's own window is opened by the tab
# itself; these are the windows filed beside it.
filed	tools	inventory
filed	api-viewer	mods
filed	refusals	docs
filed	notifications	settings
filed	determinism	settings
filed	world	map-plan
# Pinning is a layer move, declared here and not baked into a spec (UI-SPEC §4):
# these four stay visible while the shell is hidden.

pin	world
pin	streamer
pin	determinism
pin	refusals


# The map window's content is a cell data frame, not composed panels. The row's id is the
# frame's id: `voxel_package::cellframe::read` refuses a declared frame this file names by
# no row, and `voxel-layers` prints both together so a reader can check the join.
row	MAP-0001	the map window's default cells: the world's own elevation and biomes, one sample a cell, with contours the mount grades before the shell draws one
row	MAP-0002	the ocean view: the measured map centred on the nearest water, water in accent and land in disabled ink
row	MAP-0003	the mountain view: alpine cells and high ground centred on the range the ring search found
row	MAP-0004	the forest view: the five forest biomes, centred on the nearest stand
row	MAP-0005	the grassland view: grassland cells, centred on the nearest grassland
row	MAP-0006	the desert view: desert and subtropical scrub, centred on the nearest dry ground
row	MAP-0007	the tundra view: tundra and polar desert, centred on the nearest cold ground
