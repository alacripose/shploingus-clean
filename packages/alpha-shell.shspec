# The console: a bar entry that is not a tab, because a tab sorts windows and the
# console opens them (H-15.2, H-15.3).
window	console
	title	Console
	content	console
	lane	control
	extent	square-pixels
	geometry	16 96 640 406
	min-size	320 192
	opacity	930
	elevation	1
	theme-role	surface
	pinnable	false
	layout	minimize,maximize,close,title-position
	behavior	drag,resize,maximize,minimize,close
	record-id	window-console
# Console-opened, no bar home: the log and the streamer are peers of the console
# (H-15.5), and governance keeps its window without a tab.
window	log
	title	Log
	content	log
	lane	frame
	extent	square-pixels
	geometry	80 128 640 406
	min-size	320 192
	opacity	930
	elevation	1
	theme-role	surface
	pinnable	false
	layout	minimize,maximize,close,title-position
	behavior	drag,resize,maximize,minimize,close
	record-id	window-log
