	content	streamer
	lane	motion
	extent	square-pixels
	geometry	928 48 336 408
	min-size	240 192
	opacity	930
	elevation	0
	theme-role	hud
	pinnable	true
	layout	minimize,close,title-position
	behavior	drag
	record-id	window-streamer
# The pinned HUD subset (H-9.8): stays in the user's view while the shell is hidden.
#
# The four geometries below are the four corners of a 1280 × 720 window with the
# 48 dp bar across the top, sized so the panel each window hosts fits inside it:
# a 48 dp title bar plus the panel's own height (the tallest is 309 dp at five
# rows). At any other window size the windows keep these declarations — a shell
# that resized them would be choosing an arrangement, and the arrangement is a
# package (UI-SPEC §3).
window	world
	title	World
	content	world-view
	lane	world
	extent	square-pixels
	geometry	16 48 336 360
	min-size	240 192
	opacity	930
	elevation	0
	theme-role	hud
	pinnable	true
	layout	minimize,close,title-position
	behavior	drag
	record-id	window-world
window	determinism
	title	Determinism
	content	readout
	lane	frame
	extent	square-pixels
	geometry	16 408 336 312
	min-size	240 192
	opacity	930
	elevation	0
	theme-role	hud
	pinnable	true
	layout	minimize,close,title-position
	behavior	drag
	record-id	window-determinism
window	refusals
	title	Refusals
	content	table
	lane	beacon
	extent	square-pixels
	geometry	928 408 336 312
	min-size	240 192
	opacity	930
	elevation	1
	theme-role	hud
	pinnable	true
	layout	minimize,close,title-position
	behavior	drag
	record-id	window-refusals
# The six tabs of the bar, in strip order (H-15.2).
tab	inventory
tab	trees
tab	mods
tab	docs
tab	settings
tab	map-plan
# The one bar entry that is not a tab.
bar	console
# What each tab's menu offers (H-15.3). The tab's own window is opened by the tab
# itself; these are the windows filed beside it.
filed	tools	inventory
filed	api-viewer	mods
filed	refusals	docs
filed	notifications	settings
filed	determinism	settings
filed	world	map-plan
# Pinning is a layer move, declared here and not baked into a spec (UI-SPEC §4):
# these four stay visible while the shell is hidden.
pin	world
pin	streamer
pin	determinism
pin	refusals
