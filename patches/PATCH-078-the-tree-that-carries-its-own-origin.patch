@@ -0,0 +1,141 @@
+//! **The tree mob: a being with an identity and an origin, drawn at the lattice floor.**
+//!
+//! `voxel_shapers::gaia` decides where a tree stands and what it is — the cell, the species,
+//! the height, the crown, and the id that is the tree's own. This module is the other half:
+//! a body for one of those records, placed at the tree's own voxel origin through
+//! [`Mesh::placed_at`] rather than at a chunk corner, so the tree carries its position into
+//! the frame. The body is a drawing: the trunk is one voxel of wood, the crown is its
+//! envelope with a declared gap fraction, and the mass a tree would have is not claimed by
+//! either.
+//!
+//! Residency is the forest's own. A cell within [`FOREST_CELLS`] of the eye that has a tree
+//! is meshed once and kept; a cell that leaves is dropped, and a cell that is in range with
+//! no body yet is absent from the frame rather than stood in for. One body a frame.
+
+use std::collections::BTreeMap;
+
+use voxel_mesh::{Chunk, Mesh, MeshConfig, Mesher, SparseVoxelOctree};
+use voxel_model::{ChunkPos, LocalPos, VoxelShape};
+use voxel_shapers::gaia::{self, Tree};
+use voxel_shapers::materials;
+use voxel_shapers::spec::WorldSpec;
+
+/// **Cells around the eye that hold a drawn tree** — 3 × 8 m, so a 24 m radius.
+pub const FOREST_CELLS: i32 = 3;
+
+/// The local voxel the trunk stands on inside its own body frame, so a crown of ±4 m has
+/// room on every side of it.
+const PAD: i32 = 8;
+
+/// **The share of a crown's envelope that holds leaf**, declared: a crown is mostly air, and
+/// a filled envelope would be the block tree with more steps.
+const CROWN_SHARE: u32 = 24;
+
+/// One body a resident cell, keyed by the cell the being belongs to.
+#[derive(Default)]
+pub struct Forest {
+    bodies: BTreeMap<(i32, i32), Mesh>,
+}
+
+impl Forest {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Build at most one tree body this frame, and drop the ones the eye has left.
+    ///
+    /// Returns the body it built, for the report.
+    pub fn update(&mut self, spec: &WorldSpec, eye_m: [f64; 3]) -> Option<[i32; 3]> {
+        let side = (gaia::TREE_CELL_M as f64).max(1.0);
+        let eye_cell = [
+            (eye_m[0] / side).floor() as i32,
+            (eye_m[2] / side).floor() as i32,
+        ];
+        self.bodies.retain(|(cx, cz), _| {
+            (cx - eye_cell[0]).abs() <= FOREST_CELLS && (cz - eye_cell[1]).abs() <= FOREST_CELLS
+        });
+        for cell_z in (eye_cell[1] - FOREST_CELLS)..=(eye_cell[1] + FOREST_CELLS) {
+            for cell_x in (eye_cell[0] - FOREST_CELLS)..=(eye_cell[0] + FOREST_CELLS) {
+                if self.bodies.contains_key(&(cell_x, cell_z)) {
+                    continue;
+                }
+                let Some(tree) = gaia::memoized_tree_of_cell(spec, cell_x, cell_z) else {
+                    continue;
+                };
+                self.bodies.insert((cell_x, cell_z), body(&tree));
+                return Some(tree.origin_voxel());
+            }
+        }
+        None
+    }
+
+    /// The bodies this frame draws, in the streamer's own shape.
+    pub fn bodies(&self) -> impl Iterator<Item = (ChunkPos, u64, &Mesh)> {
+        self.bodies
+            .values()
+            .map(|mesh| (mesh.chunk, 0u64, mesh))
+    }
+
+    pub fn len(&self) -> usize {
+        self.bodies.len()
+    }
+}
+
+/// **One tree's body**: a trunk of wood and a crown sampled on its envelope.
+fn body(tree: &Tree) -> Mesh {
+    let mut octree = SparseVoxelOctree::new();
+    let at = |dx: i32, dy: i32, dz: i32| {
+        LocalPos::new((PAD + dx) as u32, dy as u32, (PAD + dz) as u32)
+            .expect("a body's own frame is inside its chunk")
+    };
+    for dy in 0..tree.trunk_height {
+        octree.set_voxel(at(0, dy, 0), VoxelShape::solid(materials::WOOD));
+    }
+    let top = tree.trunk_height;
+    for dy in 0..=(top + 2) {
+        for dx in -4..=4 {
+            for dz in -4..=4 {
+                if !in_crown(tree, dx, dy, dz) || !holds_leaf(tree.id, dx, dy, dz) {
+                    continue;
+                }
+                octree.set_voxel(at(dx, dy, dz), VoxelShape::solid(tree.canopy_material));
+            }
+        }
+    }
+    let chunk = Chunk::from_tree(ChunkPos::new(0, 0, 0), octree);
+    let mesh = Mesher::new()
+        .build(&chunk, &MeshConfig::air_only(), None)
+        .expect("an isolated body has no neighbour to refuse");
+    mesh.placed_at([tree.base_x - PAD, tree.base_y + 1, tree.base_z - PAD])
+}
+
+/// Whether a body-frame voxel lies inside the tree's crown envelope.
+fn in_crown(tree: &Tree, dx: i32, dy: i32, dz: i32) -> bool {
+    let r = tree.canopy_radius_m;
+    let (dxf, dzf) = (dx as f64, dz as f64);
+    if tree.conifer {
+        let skirt = tree.trunk_height - 3;
+        if dy < skirt || dy > tree.trunk_height {
+            return false;
+        }
+        let t = (dy - skirt) as f64 / 3.0;
+        let taper = r * (1.0 - 0.45 * t);
+        dxf * dxf + dzf * dzf <= taper * taper
+    } else {
+        let centre = tree.trunk_height as f64 + 0.5;
+        let dyf = (dy as f64 + 0.5 - centre) * 1.15;
+        dxf * dxf + dzf * dzf + dyf * dyf <= r * r
+    }
+}
+
+/// **The declared gap fraction**, as a hash of the tree's identity and the voxel: the same
+/// tree keeps the same gaps on every rebuild, and a different tree gets different ones.
+fn holds_leaf(id: u64, dx: i32, dy: i32, dz: i32) -> bool {
+    let h = id
+        ^ (dx as i64 as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15)
+        ^ (dy as i64 as u64).wrapping_mul(0xC2B2_AE3D_27D4_EB4F)
+        ^ (dz as i64 as u64).wrapping_mul(0x1656_67B1_9E37_79F9);
+    let h = h.wrapping_mul(0xFF51_AFD7_ED55_8CCD);
+    let h = (h ^ (h >> 33)).wrapping_mul(0xC4CE_B9FE_1A85_EC53);
+    ((h ^ (h >> 33)) % 100) < CROWN_SHARE as u64
+}
